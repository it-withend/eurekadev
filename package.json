{
  "name": "pocketlab",
  "private": true,
  "version": "0.1.0",
  "description": "Turn any smartphone into a physics lab: real experiments with the phone's own sensors, signal processing in the browser, automatic lab reports.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host --mode phone",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "datasets": "tsx scripts/generate-demo-datasets.ts",
    "lint": "eslint .",
    "validate": "tsx scripts/validate.ts",
    "e2e": "playwright test",
    "stress": "tsx scripts/stress.ts",
    "charts": "tsx scripts/charts.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "coverage": "vitest run --coverage --coverage.include=src/dsp --coverage.include=src/core --coverage.include=src/experiments --coverage.include=src/server",
    "gallery": "tsx scripts/gallery.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
